ACCESS_TOKEN=your-token-here
ALLOW_GET=true
ALLOW_POST=true
ENABLE_UA_OVERRIDE=true
MAX_CONCURRENT_READS=2
# Automatically launch an isolated Edge/Chrome window when the API starts.
# The window opens at about:blank for JD/Taobao login; set false to use a manually started CDP browser.
AUTO_LAUNCH_BROWSER=true
# This is the on-disk profile directory name, not the display name.
PROFILE_NAME=Default
# Optional: defaults to a separate viewview directory under the system temp dir.
# Do not point this at your normal Edge/Chrome User Data directory.
BROWSER_USER_DATA_DIR=
# Optional executable override and CDP port.
BROWSER_PATH=
BROWSER_CDP_PORT=9222
